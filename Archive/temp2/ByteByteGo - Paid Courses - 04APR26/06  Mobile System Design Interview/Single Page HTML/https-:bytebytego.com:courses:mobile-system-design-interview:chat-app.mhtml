  to_user_id <span class=3D"hljs-type">INTEGER</span> <span class=3D"hljs-k=
eyword">NOT NULL</span>,
  content TEXT <span class=3D"hljs-keyword">NOT NULL</span>,
  status TEXT <span class=3D"hljs-keyword">NOT NULL</span>,
  created_at TEXT <span class=3D"hljs-keyword">NOT NULL</span>,
  <span class=3D"hljs-keyword">FOREIGN KEY</span> (from_user_id) <span clas=
s=3D"hljs-keyword">REFERENCES</span> Users(id),
