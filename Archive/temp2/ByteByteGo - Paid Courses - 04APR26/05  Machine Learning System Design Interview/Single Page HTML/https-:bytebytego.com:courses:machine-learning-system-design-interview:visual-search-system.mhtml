lass=3D"mord mathnormal" style=3D"margin-right: 0.10903em;">N</span><span c=
lass=3D"mspace" style=3D"margin-right: 0.2222em;"></span><span class=3D"mbi=
n">=C3=97</span><span class=3D"mspace" style=3D"margin-right: 0.2222em;"></=
span></span><span class=3D"base"><span class=3D"strut" style=3D"height: 1em=
; vertical-align: -0.25em;"></span><span class=3D"mord mathnormal" style=3D=
"margin-right: 0.02778em;">D</span><span class=3D"mclose">)</span></span></=
span></span>, where <span class=3D"katex"><span class=3D"katex-mathml"><mat=
h xmlns=3D"http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>N</mi><=
/mrow><annotation encoding=3D"application/x-tex">N</annotation></semantics>=
</math></span><span class=3D"katex-html" aria-hidden=3D"true"><span class=
