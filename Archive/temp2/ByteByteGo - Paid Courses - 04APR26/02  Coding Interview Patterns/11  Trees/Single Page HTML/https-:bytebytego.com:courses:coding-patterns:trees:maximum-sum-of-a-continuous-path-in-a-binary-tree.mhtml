pan><span class=3D"katex-html" aria-hidden=3D"true"><span class=3D"base"><s=
pan class=3D"strut" style=3D"height: 1em; vertical-align: -0.25em;"></span>=
<span class=3D"mord mathnormal" style=3D"margin-right: 0.02778em;">O</span>=
<span class=3D"mopen">(</span><span class=3D"mord mathnormal">n</span><span=
 class=3D"mclose">)</span></span></span></span>, where <span class=3D"katex=
"><span class=3D"katex-mathml"><math xmlns=3D"http://www.w3.org/1998/Math/M=
athML"><semantics><mrow><mi>n</mi></mrow><annotation encoding=3D"applicatio=
