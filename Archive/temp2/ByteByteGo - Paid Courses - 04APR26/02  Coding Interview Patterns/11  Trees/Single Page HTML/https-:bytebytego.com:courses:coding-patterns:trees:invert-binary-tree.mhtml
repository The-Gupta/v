            stack.append(node.left)
        <span class=3D"hljs-keyword">if</span> node.right:
            stack.append(node.right)
    <span class=3D"hljs-keyword">return</span> root
</code></pre><button type=3D"button" class=3D"ant-btn css-133v4sd ant-btn-d=
