lass=3D"hljs-built_in">int</span>], nums: <span class=3D"hljs-type">List</s=
pan>[<span class=3D"hljs-built_in">int</span>], res: <span class=3D"hljs-ty=
pe">List</span>[<span class=3D"hljs-type">List</span>[<span class=3D"hljs-b=
uilt_in">int</span>]]</span>) -&gt; <span class=3D"hljs-literal">None</span=
>:
    <span class=3D"hljs-comment"># Base case: if all elements have been con=
sidered, add the current subset to the</span>
    <span class=3D"hljs-comment"># output.</span>
    <span class=3D"hljs-keyword">if</span> i =3D=3D <span class=3D"hljs-bui=
lt_in">len</span>(nums):
        res.append(curr_subset[:])
        <span class=3D"hljs-keyword">return</span>
    <span class=3D"hljs-comment"># Include the current element and recursiv=
ely explore all paths that branch from</span>
    <span class=3D"hljs-comment"># this subset.</span>
    curr_subset.append(nums[i])
    backtrack(i + <span class=3D"hljs-number">1</span>, curr_subset, nums, =
res)
    <span class=3D"hljs-comment"># Exclude the current element and recursiv=
ely explore all paths that branch from</span>
    <span class=3D"hljs-comment"># this subset.</span>
    curr_subset.pop()
    backtrack(i + <span class=3D"hljs-number">1</span>, curr_subset, nums, =
res)
