nction_">FixedDiscountDecorator</span><span class=3D"hljs-params">(Discount=
CalculationStrategy strategy, BigDecimal fixedAmount)</span> {
        <span class=3D"hljs-built_in">this</span>.strategy =3D strategy;
        <span class=3D"hljs-built_in">this</span>.fixedAmount =3D fixedAmou=
nt;
