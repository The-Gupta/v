    }

    <span class=3D"hljs-keyword">public</span> <span class=3D"hljs-keyword"=
>void</span> <span class=3D"hljs-title function_">generatePayrollReport</sp=
an><span class=3D"hljs-params">()</span> {
        System.out.println(<span class=3D"hljs-string">"Payroll Report for =
"</span> + name + <span class=3D"hljs-string">": $"</span> + salary * <span=
