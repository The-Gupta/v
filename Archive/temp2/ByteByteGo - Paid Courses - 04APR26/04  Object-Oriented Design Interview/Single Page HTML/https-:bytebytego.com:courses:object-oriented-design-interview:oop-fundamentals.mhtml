<span class=3D"hljs-comment">// Interface</span>
<span class=3D"hljs-keyword">interface</span> <span class=3D"hljs-title cla=
ss_">Drawable</span> {
    <span class=3D"hljs-keyword">void</span> <span class=3D"hljs-title func=
tion_">draw</span><span class=3D"hljs-params">()</span>;
}

<span class=3D"hljs-comment">// Concrete class implementing Shape and Drawa=
ble</span>
<span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title class_"=
>Circle</span> <span class=3D"hljs-keyword">extends</span> <span class=3D"h=
ljs-title class_">Shape</span> <span class=3D"hljs-keyword">implements</spa=
n> <span class=3D"hljs-title class_">Drawable</span> {
    <span class=3D"hljs-keyword">private</span> <span class=3D"hljs-type">d=
ouble</span> radius;

    <span class=3D"hljs-keyword">public</span> <span class=3D"hljs-title fu=
nction_">Circle</span><span class=3D"hljs-params">(String color, <span clas=
s=3D"hljs-type">double</span> radius)</span> {
        <span class=3D"hljs-built_in">super</span>(color);
        <span class=3D"hljs-built_in">this</span>.radius =3D radius;
