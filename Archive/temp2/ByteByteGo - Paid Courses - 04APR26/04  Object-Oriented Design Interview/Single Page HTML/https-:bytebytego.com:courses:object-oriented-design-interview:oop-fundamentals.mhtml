nction_">Employee</span><span class=3D"hljs-params">(String name, <span cla=
ss=3D"hljs-type">double</span> salary)</span> {
        <span class=3D"hljs-built_in">this</span>.name =3D name;
        <span class=3D"hljs-built_in">this</span>.salary =3D salary;
    }

    <span class=3D"hljs-keyword">public</span> <span class=3D"hljs-type">do=
uble</span> <span class=3D"hljs-title function_">calculateSalary</span><spa=
