        <span class=3D"hljs-keyword">final</span> List&lt;File&gt; result =
=3D fileSearch.search(root, criteria);

        <span class=3D"hljs-comment">// Verify that only one file matches t=
he criteria</span>
        assertEquals(<span class=3D"hljs-number">1</span>, result.size());
        <span class=3D"hljs-comment">// Verify that the matching file is "b=
"</span>
